{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowd.local/schemas/common.schema.json",
  "title": "Common types",
  "$defs": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "timestamp": { "type": "string", "format": "date-time" },
    "point": {
      "description": "Local venue coordinates in metres (x east, y north).",
      "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
    },
    "polygon": {
      "description": "Simple polygon, vertices in order, not repeated at the end.",
      "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 3
    },
    "segment": {
      "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 2, "maxItems": 2
    },
    "mode": { "enum": ["normal", "egress", "evacuation"] },
    "target_ref": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["zone", "threshold"] },
        "id": { "$ref": "#/$defs/id" }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
