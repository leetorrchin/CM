{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowd.local/schemas/venue.schema.json",
  "title": "Venue",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string" },
    "units": { "const": "metres" },
    "anchor": {
      "description": "Optional link from local coordinates to the real world.",
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "rotation_deg": { "type": "number" }
      },
      "required": ["lat", "lon"],
      "additionalProperties": false
    },
    "levels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "elevation_m": { "type": "number" }
        },
        "required": ["id", "elevation_m"],
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "level": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["open_area", "corridor", "stage_front", "concourse", "queue", "seating", "assembly_point", "restricted"] },
          "polygon": { "$ref": "common.schema.json#/$defs/polygon" },
          "capacity": {
            "description": "Overrides for derived capacity (area times max_density).",
            "type": "object",
            "properties": {
              "max_density_pp_m2": { "type": "number", "exclusiveMinimum": 0 },
              "max_people": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "step_free": { "type": "boolean", "default": true }
        },
        "required": ["id", "level", "kind", "polygon"],
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "kind": { "enum": ["opening", "gate", "door", "stairs", "ramp", "barrier_gap"] },
          "from_zone": { "$ref": "common.schema.json#/$defs/id" },
          "to_zone": { "$ref": "common.schema.json#/$defs/id" },
          "segment": { "$ref": "common.schema.json#/$defs/segment" },
          "width_m": { "type": "number", "exclusiveMinimum": 0 },
          "max_flow_pp_s": { "type": "number", "exclusiveMinimum": 0 },
          "one_way": { "type": "boolean", "default": false },
          "step_free": { "type": "boolean", "default": true },
          "closable": { "type": "boolean", "default": true }
        },
        "required": ["id", "kind", "from_zone", "to_zone", "segment", "width_m"],
        "additionalProperties": false
      }
    },
    "pathways": {
      "description": "Designated routes, as ordered zones. Used for signage and pre-computed fallback plans.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "zones": { "type": "array", "minItems": 2, "items": { "$ref": "common.schema.json#/$defs/id" } },
          "one_way": { "type": "boolean", "default": false },
          "purpose": { "enum": ["general", "egress", "evacuation", "accessible"] }
        },
        "required": ["id", "zones"],
        "additionalProperties": false
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "kind": { "enum": ["entry", "exit", "stage", "food", "toilets", "medical", "meeting_point", "assembly_point"] },
          "zone": { "$ref": "common.schema.json#/$defs/id" },
          "safe": { "type": "boolean", "description": "True if reaching it ends an evacuation." }
        },
        "required": ["id", "kind", "zone"],
        "additionalProperties": false
      }
    },
    "sensor_sites": {
      "description": "Where occupancy sensors exist and what they cover. Lets connectors map readings to zones and thresholds.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["camera", "turnstile", "wifi", "ble", "manual"] },
          "covers": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/target_ref" } }
        },
        "required": ["id", "kind", "covers"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "id", "units", "levels", "zones", "thresholds", "destinations"],
  "additionalProperties": false
}
