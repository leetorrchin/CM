{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crowd.local/schemas/plan.schema.json",
  "title": "Plan",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" },
    "mode": { "$ref": "common.schema.json#/$defs/mode" },
    "planner": { "type": "string" },
    "horizon_s": { "type": "number", "exclusiveMinimum": 0 },
    "assignments": {
      "description": "Next step for each entity or group.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["entity", "group"] },
              "id": { "$ref": "common.schema.json#/$defs/id" }
            },
            "required": ["kind", "id"],
            "additionalProperties": false
          },
          "next_threshold": { "$ref": "common.schema.json#/$defs/id" },
          "destination_id": { "$ref": "common.schema.json#/$defs/id" },
          "eta_s": { "type": "number", "minimum": 0 }
        },
        "required": ["subject", "destination_id"],
        "additionalProperties": false
      }
    },
    "threshold_flows": {
      "description": "Planned flow through each threshold, used by the visualiser and for zone-level planning.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "threshold_id": { "$ref": "common.schema.json#/$defs/id" },
          "flow_pp_s": { "type": "number", "minimum": 0 }
        },
        "required": ["threshold_id", "flow_pp_s"],
        "additionalProperties": false
      }
    },
    "closed_thresholds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
  },
  "required": ["schema_version", "timestamp", "mode", "assignments"],
  "additionalProperties": false
}
